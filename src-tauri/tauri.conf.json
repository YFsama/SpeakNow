{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeakNow",
  "version": "0.4.6",
  "identifier": "com.speaknow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SpeakNow 语音输入助手",
        "width": 980,
        "height": 740,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "SpeakNow",
        "url": "overlay.html",
        "width": 560,
        "height": 320,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "快捷键语音输入 · 大模型 ASR · AI 纠错",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
